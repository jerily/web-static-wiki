{% extends 'page.html.jinja' %}
{% block body %}
<div class="actions">
  <a href="{{ parent }}">← Browse</a>
</div>
{% if date %}<p class="eyebrow">{{ date }}</p>{% endif %}
{# Only safe-mode cmark output is marked safe; metadata keeps automatic escaping. #}
<article aria-label="{{ title }}">
  <h1>{{ title }}</h1>
  {{ markdown_html|safe }}
</article>
{% endblock %}
